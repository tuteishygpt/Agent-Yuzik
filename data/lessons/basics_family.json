{
  "lesson_id": "basics_family",
  "title": "Сям'я",
  "level": "A1",
  "lesson_goal": "Назваць членаў сям'і па-беларуску",
  "steps": [
    {"step_id": "intro", "type": "intro", "prompt": "Паўтары ўслых два словы: мама, тата.", "hint": "Прамаўляй па парадку: мама, тата."},
    {"step_id": "ask_sister", "type": "ask", "prompt": "Якім словам па-беларуску называюць дзяўчыну, якая мае тых самых бацькоў?", "expected_answer": "сястра", "hint": "У адказе трэба слова сястра."},
    {"step_id": "ask_brother", "type": "ask", "prompt": "Назаві па-беларуску хлопца, які нарадзіўся ў той самай сям'і.", "expected_answer": "брат", "hint": "Правільны адказ: брат."},
    {"step_id": "ask_grandmother", "type": "ask", "prompt": "Як сказаць па-беларуску пра маму таты або мамы?", "expected_answer": "бабуля", "hint": "Тут падыходзіць слова бабуля."},
    {"step_id": "ask_grandfather", "type": "ask", "prompt": "Якое беларускае слова абазначае бацьку мамы або таты?", "expected_answer": "дзядуля", "hint": "Патрэбнае слова — дзядуля."},
    {"step_id": "ask_family", "type": "ask", "prompt": "Як па-беларуску назваць самых блізкіх людзей дома?", "expected_answer": "сям'я", "hint": "Адказ пачынаецца і заканчваецца словам сям'я."},
    {"step_id": "ask_affinity", "type": "ask", "prompt": "Якім словам называюць роднасныя дачыненні, што ўзнікаюць праз шлюб?", "expected_answer": "сваяцтва", "hint": "Тэрмін з урока: сваяцтва."},
    {"step_id": "ask_son_in_law", "type": "ask", "prompt": "Як завуць мужа дачкі ў беларускай мове?", "expected_answer": "зяць", "hint": "Гэта кароткае слова: зяць."},
    {"step_id": "ask_father_in_law_husband_side", "type": "ask", "prompt": "Якое слова трэба сказаць пра бацьку мужа?", "expected_answer": "свёкар", "hint": "Ужываецца назва свёкар."},
    {"step_id": "ask_mother_in_law_husband_side", "type": "ask", "prompt": "Як у беларускай мове называецца маці мужа?", "expected_answer": "сьвякроў|свякроў|сьвякруха|свякруха|сьвекрыва|свекрыва", "hint": "Тут патрэбна форма сьвякроў."},
    {"step_id": "ask_brother_in_law_husband_side", "type": "ask", "prompt": "Назаві адным словам брата мужа.", "expected_answer": "дзевер", "hint": "Успомні слова дзевер."},
    {"step_id": "ask_sister_in_law_husband_side", "type": "ask", "prompt": "Якім словам абазначаюць сястру мужа?", "expected_answer": "залвіца|залоўка", "hint": "Правільная назва — залвіца."},
    {"step_id": "ask_daughter_in_law", "type": "ask", "prompt": "Як па-беларуску называюць жонку сына?", "expected_answer": "нявестка|сынавая|сыновая", "hint": "Патрэбны адказ: нявестка."},
    {"step_id": "ask_father_in_law_wife_side", "type": "ask", "prompt": "Скажы беларускае слова для бацькі жонкі.", "expected_answer": "цесьць", "hint": "Гаворка пра цесьця: цесьць."},
    {"step_id": "ask_mother_in_law_wife_side", "type": "ask", "prompt": "Як трэба назваць маці жонкі?", "expected_answer": "цешча", "hint": "У адказе павінна быць цешча."},
    {"step_id": "ask_brother_in_law_wife_side", "type": "ask", "prompt": "Якое слова ўжываюць, калі гавораць пра брата жонкі?", "expected_answer": "швагер", "hint": "Падказка з урока — швагер."},
    {"step_id": "ask_sister_in_law_wife_side", "type": "ask", "prompt": "Як у беларускай мове называюць сястру жонкі?", "expected_answer": "швагерка", "hint": "Тут трэба адказаць швагерка."},
    {"step_id": "ask_matchmakers", "type": "ask", "prompt": "Як называюць бацькоў мужа і жонкі адзін да аднаго?", "expected_answer": "сваты", "hint": "Гэта слова ў множным ліку: сваты."},
    {"step_id": "ask_stepfather", "type": "ask", "prompt": "Назаві словам мужа маці, які не з'яўляецца родным бацькам дзіцяці.", "expected_answer": "айчым", "hint": "Патрэбнае сямейнае слова — айчым."},
    {"step_id": "ask_stepmother", "type": "ask", "prompt": "Як сказаць пра жонку бацькі, якая не з'яўляецца роднай маці?", "expected_answer": "мачыха", "hint": "У гэтым выпадку кажуць мачыха."},
    {"step_id": "ask_stepson", "type": "ask", "prompt": "Якое слова абазначае хлопца ад ранейшага шлюбу мужа або жонкі?", "expected_answer": "пасынак", "hint": "Успомні назву пасынак."},
    {"step_id": "ask_stepdaughter", "type": "ask", "prompt": "Як па-беларуску называюць дзяўчыну ад папярэдняга шлюбу мужа або жонкі?", "expected_answer": "падчарыца", "hint": "Правільны варыянт — падчарыца."},
    {"step_id": "ask_step_siblings", "type": "ask", "prompt": "Як сказаць пра дзяцей у новай сям'і, якія не маюць агульных бацькоў, але жывуць як брат і сястра?", "expected_answer": "зводныя браты і сёстры", "hint": "Гэта словазлучэнне: зводныя браты і сёстры."},
    {"step_id": "sentence", "type": "sentence", "prompt": "Складзі просты сказ пра сваю сям'ю.", "expected_answer": "мая сям'я", "hint": "Можна пачаць так: Мая сям'я..."},
    {"step_id": "sentence_about_mother", "type": "sentence", "prompt": "Ужы слова мама ў кароткім сказе.", "expected_answer": "гэта мая мама", "hint": "Падыдзе прыклад: Гэта мая мама."},
    {"step_id": "sentence_about_brother", "type": "sentence", "prompt": "Пабудуй сказ, дзе будзе слова брат.", "expected_answer": "гэта мой брат", "hint": "Пачатак можа быць такі: Гэта мой брат."},
    {"step_id": "sentence_about_affinity", "type": "sentence", "prompt": "Складзі выказванне са словам сваяцтва.", "expected_answer": "гэта сваяцтва", "hint": "Паспрабуй фразу: Гэта сваяцтва праз шлюб."},
    {"step_id": "sentence_about_stepfamily", "type": "sentence", "prompt": "Зрабі прыклад сказа з адным са слоў: айчым або мачыха.", "expected_answer": "гэта мой айчым", "hint": "Напрыклад, можна сказаць: Гэта мой айчым."},
    {"step_id": "summary", "type": "summary", "prompt": "Пералічы восем слоў на тэму сям'і і сваяцтва.", "hint": "Успомні восем слоў пра родных і сваякоў."}
  ],
