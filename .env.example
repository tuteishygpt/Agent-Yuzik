# Core model/API keys
GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_API_KEY can be used instead of GEMINI_API_KEY if preferred.
GOOGLE_API_KEY=

# Telegram/Webhook
TELEGRAM_BOT_TOKEN=
WEBHOOK_BASE_URL=https://your-public-base-url.example.com
WEBHOOK_SECRET_TOKEN=

# Local backend port.
# Use 7861 if you want it to match the current Vite dev proxy in frontend/vite.config.js.
PORT=7861
AGENT_TIMEOUT=60

# Voice / TTS
TTS_MODE=local
HF_TOKEN=
HUGGINGFACE_API_TOKEN=
SIMPLE_VOICE_AGENT=true
SIMPLE_VOICE_MODEL=gemini-3.1-flash-lite-preview
IMAGE_GENERATION_MODEL=
SIMPLE_VOICE_DEBUG_TIMESTAMPS=true
LOCAL_ASR=true
LOCAL_ASR_MODEL=nvidia/stt_be_fastconformer_hybrid_large_pc

# Supabase backend config
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_UPLOAD_BUCKET=user-uploads
SUPABASE_ARTIFACT_BUCKET=assistant-artifacts

# Supabase auth callbacks
SUPABASE_WEB_CALLBACK_DEV=http://localhost:5173/auth/callback
SUPABASE_WEB_CALLBACK_PROD=https://your-app.example.com/auth/callback
SUPABASE_MOBILE_CALLBACK_DEV=yuzik-dev://auth/callback
SUPABASE_MOBILE_CALLBACK_PROD=yuzik://auth/callback

# Optional:
# SIMPLE_VOICE_SYSTEM_PROMPT uses the in-code default unless you explicitly override it.
